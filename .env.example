# demo 为离线演示；auto 在配置 LLM_API_KEY 后启用真实模型。
AI_MODE=demo
LLM_API_BASE=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-flash
LLM_TIMEOUT=60
MAX_AGENT_STEPS=6
MAX_REPAIR_ATTEMPTS=2
RAG_TOP_K=4
RAG_CHUNK_SIZE=480
RAG_CHUNK_OVERLAP=80

# 可选：配置支持 /embeddings 的服务；不默认复用其他服务密钥。
EMBEDDING_API_BASE=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# demo 是占位演示背景；dashscope 为真实背景生成。
# 上传透明PNG后商品原图由程序合成，不交给模型重画。
IMAGE_PROVIDER=demo
IMAGE_API_BASE=https://dashscope.aliyuncs.com/api/v1
IMAGE_API_KEY=
IMAGE_MODEL=wanx2.1-t2i-turbo

# 可选数据目录，默认 data/runtime
# ADCRAFT_DATA_DIR=/absolute/path/to/data
